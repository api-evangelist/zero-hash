{
  "opencollection": "1.0.0",
  "info": {
    "name": "zerohash Awards API",
    "version": "1.7.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-SCX-API-KEY",
      "value": "{{X-SCX-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Awards",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Fund awards account",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.cert.zerohash.com/awards/fund",
            "headers": [
              {
                "name": "X-SCX-SIGNED",
                "value": ""
              },
              {
                "name": "X-SCX-TIMESTAMP",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Define the quantity, quoted currency, and asset that you plan to distribute to customers through the `POST /awards/distribute` endpoint."
        },
        {
          "info": {
            "name": "Distribute awards",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.cert.zerohash.com/awards/distribute",
            "headers": [
              {
                "name": "X-SCX-SIGNED",
                "value": ""
              },
              {
                "name": "X-SCX-TIMESTAMP",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Evenly distribute the purchased crypto among the specified customers."
        }
      ]
    }
  ],
  "bundled": true
}