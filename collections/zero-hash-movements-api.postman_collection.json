          "name": "List movements",
          "request": {
            "name": "List movements",
            "description": {
              "content": "Retrieves the history of each itemized movement that has been applied to all account(s) that the requesting platform has access to. Results are limited to the last 2 months",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "movements"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<number>",
                  "description": "Page number for pagination (starts at 1)."
                },
                {
                  "disabled": false,
                  "key": "page_size",
                  "value": "<number>",
                  "description": "Number of items per page for pagination. Default and maximum is 100"
                },
                {
                  "disabled": false,
                  "key": "parent_link_id",
                  "value": "<string>",
                  "description": "Filters for movements that are tagged with a specific `parent_link_id`."
                },
                {
                  "disabled": false,
                  "key": "movement_type",
                  "value": "<string>",
                  "description": "The type of the movement"
                },
                {
                  "disabled": false,
                  "key": "transfer_type",
                  "value": "<string>",
                  "description": "Filters for movements with a specific `transfer_type`."
                },
                {
                  "disabled": false,
                  "key": "account_id",
                  "value": "<string>",
                  "description": "This parameter enables the filtering of movements based on the associated `account_id`."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) HMAC-SHA256 signature of the request, base64-encoded. See the [Authentication guide](https://docs.zerohash.com/reference/api-authentication) for the exact signing formula.",
                "key": "X-SCX-SIGNED",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "(Required) Current Unix timestamp in seconds. Must be within 60 seconds of server time or the request is rejected.",
                "key": "X-SCX-TIMESTAMP",
                "value": "<string>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
