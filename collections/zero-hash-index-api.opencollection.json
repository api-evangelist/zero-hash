{
  "opencollection": "1.0.0",
  "info": {
    "name": "zerohash Index API",
    "version": "1.7.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-SCX-API-KEY",
      "value": "{{X-SCX-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Index",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List index prices",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cert.zerohash.com/index",
            "headers": [
              {
                "name": "X-SCX-SIGNED",
                "value": ""
              },
              {
                "name": "X-SCX-TIMESTAMP",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "underlying",
                "value": "",
                "type": "query",
                "description": "underlying currency"
              },
              {
                "name": "quoted_currency",
                "value": "",
                "type": "query",
                "description": "quoted currency"
              }
            ]
          },
          "docs": "Request the latest zerohash index value for the most recently calculated data."
        }
      ]
    }
  ],
  "bundled": true
}