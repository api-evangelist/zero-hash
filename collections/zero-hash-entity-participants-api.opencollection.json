                "value": ""
              }
            ],
            "params": [
              {
                "name": "participant_code",
                "value": "",
                "type": "path",
                "description": "Unique participant identifier. Always 6 uppercase alphanumeric characters."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates an entity customer affiliated with your platform. Your platform will need to be configured properly before you can use this endpoint."
        },
        {
          "info": {
            "name": "Update entity user",
            "type": "http"
