          "info": {
            "name": "Create entity customer",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.cert.zerohash.com/participants/entity/new",
            "headers": [
              {
                "name": "X-SCX-SIGNED",
                "value": ""
              },
              {
                "name": "X-SCX-TIMESTAMP",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Submits an entity customer to be affiliated with your platform. Your platform will need to be configured properly before you can use this endpoint."
        },
        {
          "info": {
            "name": "Update entity customer",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.cert.zerohash.com/participants/entity/:participant_code",
