{
  "opencollection": "1.0.0",
  "info": {
    "name": "zerohash Entity Participants API",
    "version": "1.7.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-SCX-API-KEY",
      "value": "{{X-SCX-API-KEY}}",
      "placement": "header"
